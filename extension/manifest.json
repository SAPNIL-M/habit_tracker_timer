{
  "manifest_version": 3,
  "name": "Profile Stopwatch Gate",
  "version": "1.0.0",
  "description": "Locks the local profile stopwatch to the sapnilm.working@gmail.com Chrome profile and reports when that profile is in use.",
  "permissions": ["identity", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"]
}
